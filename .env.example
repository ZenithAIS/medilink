# دامنه سایت — برای تگ‌های canonical و Open Graph
NEXT_PUBLIC_SITE_URL=https://medilinkapp.online
# آدرس پنل کلینیک (اپ)
NEXT_PUBLIC_PANEL_URL=https://app.medilinkapp.online

# دیتابیس اپ (medilink-app) — تنها دیتابیس سایت: سفارش‌ها، بلاگ، لیدها، خبرنامه و ادمین.
# هر سه فقط سمت سرور. PUBLISHABLE_KEY کلید sb_publishable_… و SERVICE_ROLE_KEY کلید secret (sb_secret_…).
APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
APP_SUPABASE_PUBLISHABLE_KEY=
APP_SUPABASE_SERVICE_ROLE_KEY=

# زرین‌پال — تا این خالی باشد، Checkout به‌جای درگاه فقط سفارش را ثبت می‌کند
# (حالتِ فعلیِ Production، چون مرچنت هنوز تأیید نشده). از پنل merchant.zarinpal.com،
# بخش تنظیمات درگاه. فقط سمت سرور — هرگز NEXT_PUBLIC_ نکنید و در گیت کامیت نکنید.
# فعال‌سازیِ نهایی:  ZARINPAL_MERCHANT_ID=<merchant id واقعی>  و  ZARINPAL_SANDBOX=false
# تستِ Sandbox:      ZARINPAL_MERCHANT_ID=<merchant id سازگار با sandbox>  و  ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
