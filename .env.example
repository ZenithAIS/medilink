# Supabase — Project Settings › API Keys
# مقادیر واقعی را در .env.local بگذارید (این فایل فقط نمونه است)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# فقط سمت سرور — هرگز NEXT_PUBLIC_ نکنید و در گیت کامیت نکنید
SUPABASE_SERVICE_ROLE_KEY=

# دامنه سایت — برای تگ‌های canonical و Open Graph
NEXT_PUBLIC_SITE_URL=https://medilink.ir

# شماره واتساپ دکمه شناور (فرمت بین‌المللی، بدون +)
NEXT_PUBLIC_WHATSAPP_NUMBER=989120000000
